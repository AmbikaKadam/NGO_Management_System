# App environment. Use production only behind HTTPS.
ENVIRONMENT=development

# PostgreSQL URL for the database initialized from database/schema.sql.

DATABASE_URL=postgresql+psycopg://ngo_user:change-me@localhost:5432/ngo_management

# Create with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-unique-random-secret-with-at-least-32-characters
JWT_EXPIRE_MINUTES=10080
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:5174
HOST=127.0.0.1
PORT=8000
